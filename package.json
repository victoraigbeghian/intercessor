{
    "name": "intercessor",
    "version": "1.0.0",
    "description": "Intercessor WordPress Plugin — Gutenberg block build tooling",
    "private": true,
    "license": "GPL-2.0-or-later",
    "scripts": {
        "build": "cross-env NODE_ENV=production webpack --config webpack.config.js",
        "start": "cross-env NODE_ENV=development webpack --config webpack.config.js --watch",
        "lint:js": "eslint src/blocks",
        "zip": "node scripts/package-plugin.js",
        "package": "npm run build && node scripts/package-plugin.js",
        "packages-update": "npm update"
    },
    "devDependencies": {
        "@babel/core": "^7.24.0",
        "@babel/preset-env": "^7.24.0",
        "@babel/preset-react": "^7.24.0",
        "@wordpress/dependency-extraction-webpack-plugin": "^6.0.0",
        "adm-zip": "^0.5.17",
        "babel-loader": "^10.1.1",
        "copy-webpack-plugin": "^14.0.0",
        "cross-env": "^10.1.0",
        "css-loader": "^7.1.4",
        "style-loader": "^4.0.0",
        "webpack": "^5.91.0",
        "webpack-cli": "^7.0.3"
    },
    "dependencies": {
        "@wordpress/block-editor": "*",
        "@wordpress/blocks": "*",
        "@wordpress/components": "*",
        "@wordpress/element": "*",
        "@wordpress/i18n": "*"
    }
}
